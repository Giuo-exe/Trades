										bool confirmedPullback = core.isMoreExtreme(isIndex, pullback, core.sidePivotAt(isIndex, offset + 1)) and core.isMoreExtreme(isIndex, pullback, core.sidePivotAt(isIndex, offset - 1))
										if confirmedPullback and not na(previousPivotBar) and b > previousPivotBar
