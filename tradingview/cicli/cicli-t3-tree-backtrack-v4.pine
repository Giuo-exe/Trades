							int branchBaseBar = chainSize >= branchOffset ? array.get(chain, chainSize - branchOffset).startBar : scenario.startBar
							[lastT6, lastT5, lastT4] = core.collectRaccordoCooldowns(chain, 0, math.min(branchBaseBar, liveRaccBar))
							if grade != RACC_INVALID and core.raccordoPhaseAllowed(cfg, ctx, isIndex, grade, liveRaccBar) and core.raccordoSpacingFromCooldowns(cfg, grade, liveRaccBar, lastT6, lastT5, lastT4)
								int offset = bar_index - liveRaccBar
								bool leftOk = not na(liveRaccLevel) and core.scanOffsetOk(offset) and core.checkSwingCondition(isIndex, true, offset, liveRaccLevel, 3)
								bool shortRight = leftOk and core.checkRightConditionForRaccordo(isIndex, liveRaccBar, liveRaccLevel, grade)
								bool raccordoRight = shortRight and core.checkSwingCondition(isIndex, false, offset, liveRaccLevel, currentCheckDelay)
								bool fullRightAlive = raccordoRight or bar_index < liveRaccBar + currentCheckDelay and core.rightConditionAlive(isIndex, offset, liveRaccLevel, currentCheckDelay)
								if shortRight and fullRightAlive
									computedRaccordoPenalty := raccordoRight ? (grade == RACC_T6 ? 8 : grade == RACC_T5 ? 16 : 25) : (grade == RACC_T6 ? 4 : grade == RACC_T5 ? 8 : 13)
									raccordoDriver := "R(" + core.raccText(grade) + ") " + (raccordoRight ? "conf." : "poss.") + morphologyDriver
							scenario.score := math.max(0, 100 - timePenalty - computedRaccordoPenalty - alternativePenalty - morphologyPenalty)
							scenario.driver := raccordoDriver + " · ALTERNATIVA " + str.tostring(freeLineages) + (weeklyFree ? " · W libera" : "")
		table.clear(constraintTable, 0, 0, 2, 8)
		int nextTableRow = 0
		if showConstraintPanel
			color headerBg = color.new(color.rgb(35, 47, 62), 8)
			constraintRow(nextTableRow, "Lato", "Centratura", "Score\nvincolo", color.white, color.white, color.white, headerBg)
			nextTableRow += 1
			for side = 0 to 1
				bool tableIndex = side == 0
				core.ConstraintScenario[] tableScenarios = tableIndex ? indexScenarios : inverseScenarios
				core.CycleNode[] tableChain = core.sideRuntime(ctx, tableIndex).chain
				int tableCycleId = array.size(tableChain) > 0 ? array.last(tableChain).id : 0
				// Slot 0 conserva la prima principale; 1..3 sono ordinati per score/rank.
				core.ConstraintScenario[] tableTop = array.new<core.ConstraintScenario>(4, na)
				for tableScenario in tableScenarios
					if tableScenario.rank >= 9000 and na(array.get(tableTop, 0)) and (not na(tableScenario.lockBar) or tableScenario.invalidated)
						array.set(tableTop, 0, tableScenario)
					else if tableScenario.rank < 9000 and not na(tableScenario.lockBar) and not tableScenario.invalidated
						for altSlot = 1 to 3
							if core.diagnosticTableBetter(tableScenario, array.get(tableTop, altSlot))
								array.insert(tableTop, altSlot, tableScenario)
								array.pop(tableTop)
								break
				int tableDrawn = 0
				for slot = 0 to 3
					core.ConstraintScenario tableScenario = array.get(tableTop, slot)
					if tableDrawn < 3 and not na(tableScenario)
						string sideName = tableIndex ? "Indice" : "Inverso"
						string scoreBand = na(tableScenario.score) ? "" : tableScenario.score >= 90 ? "ALTA" : tableScenario.score >= 70 ? "MEDIA" : tableScenario.score >= 45 ? "FRAGILE" : "BASSA"
						string scoreText = tableScenario.invalidated ? "0/100 · INVALIDATO" : str.tostring(tableScenario.score) + "/100 · " + scoreBand + "\n" + tableScenario.driver
						string scenarioName = (slot == 0 ? "PRINCIPALE" : "ALTERNATIVA " + str.tostring(slot)) + "\n" + core.fmtLbl(tableIndex, math.max(0, tableCycleId), false)
						color scoreColor = na(tableScenario.score) ? color.gray : tableScenario.score >= 90 ? color.rgb(76, 210, 145) : tableScenario.score >= 70 ? color.rgb(255, 209, 102) : tableScenario.score >= 45 ? color.rgb(255, 150, 92) : color.rgb(255, 105, 120)
						color rowBg = slot == 0 ? color.new(color.rgb(51, 74, 94), 38) : color.new(color.rgb(25, 36, 49), 42)
						constraintRow(nextTableRow, sideName, scenarioName, scoreText, tableIndex ? labelColorIndex : labelColorInverse, color.white, scoreColor, rowBg)
						nextTableRow += 1
						tableDrawn += 1
		for side = 0 to 1
			bool isIndex = side == 0
			core.SideRuntime state = core.sideRuntime(ctx, isIndex)
			core.ConstraintMarker[] dmMarkers = isIndex ? indexMarkers : inverseMarkers
			core.ConstraintScenario[] dmScenarios = isIndex ? indexScenarios : inverseScenarios
			label[] dmStore = state.scenarioLabels
			core.clearLabelStore(dmStore)
			int dmConstraintLockBar = na
			if array.size(dmScenarios) > 0
				core.ConstraintScenario dmPrimary = array.first(dmScenarios)
				if dmPrimary.rank >= 9000 and not dmPrimary.invalidated
					dmConstraintLockBar := dmPrimary.lockBar
			string dmCenteringLegend = ""
			string dmExplanationLegend = ""
			bool dmHasDoubt = false
			if showConstraintAlternatives and not na(dmConstraintLockBar) and array.size(dmMarkers) > 0
				int[] dmVisibleLineages = array.new<int>()
				while array.size(dmVisibleLineages) < visibleConstraintAlternatives
					int dmBestLineage = na
					int dmBestRank = -100000
					for dmMarker in dmMarkers
						bool dmNeedsDot = not showGhosts or dmMarker.rank < 5000 or dmMarker.rank >= 7000
						int dmVisualRank = dmMarker.rank + (not na(dmMarker.closeBar) ? 10000 : 0)
						if dmNeedsDot and not array.includes(dmVisibleLineages, dmMarker.lineageBar) and dmVisualRank > dmBestRank
							dmBestLineage := dmMarker.lineageBar
							dmBestRank := dmVisualRank
					if na(dmBestLineage)
						break
					array.push(dmVisibleLineages, dmBestLineage)
				// Un solo pallino per lineage: i normali "?" mostrano gia' le singole
				// chiusure candidate; qui evidenziamo soltanto la centratura libera corrente.
				if array.size(dmVisibleLineages) > 0
					for [dmPosition, dmLineageBar] in dmVisibleLineages
						core.ConstraintMarker dmLatest = na
						bool dmCanReassignLock = false
						for dmMarker in dmMarkers
							bool dmNeedsDot = not showGhosts or dmMarker.rank < 5000 or dmMarker.rank >= 7000
							if dmNeedsDot and dmMarker.lineageBar == dmLineageBar
								dmCanReassignLock := dmCanReassignLock or not na(dmMarker.closeBar) and dmMarker.closeBar >= dmConstraintLockBar
								if na(dmLatest) or dmMarker.startBar > dmLatest.startBar or (dmMarker.startBar == dmLatest.startBar and dmMarker.rank > dmLatest.rank)
									dmLatest := dmMarker
						if not na(dmLatest)
							bool dmWeeklyFree = dmLatest.rank >= 7000
							int dmStartCycleId = dmLatest.cycleId
							string dmStartText = (dmWeeklyFree ? (isIndex ? "New T? / " : "New Ti? / ") : "") + core.fmtLbl(isIndex, math.max(0, dmStartCycleId), false)
							int dmOffset = bar_index - dmLatest.startBar
							if core.historyOffsetOk(dmOffset)
								float dmMarkerPrice = core.sidePivotAt(isIndex, dmOffset)
								float dmGap = math.max(math.max(nz(constraintAtr) * 0.12, math.abs(dmMarkerPrice) * 0.0005), syminfo.mintick * 4.0)
								float dmMarkerY = dmMarkerPrice + (isIndex ? -dmGap : dmGap) * 1.15
								string dmNumber = str.tostring(dmPosition + 1)
								string dmGlyph = core.markerShapeGlyph(alternativeMarkerShape, isIndex)
								string dmMarkerText = "ALTERNATIVA " + dmNumber + "\n" + dmStartText + " parte qui senza vincolo." + (dmCanReassignLock ? "\nIl vincolo puo' appartenere al ciclo precedente." : "")
								label dmLbl = core.plainTimeLabel(time[dmOffset], dmMarkerY, dmGlyph, alternativeOpenColor, size.large)
								label.set_tooltip(dmLbl, dmMarkerText)
								array.push(dmStore, dmLbl)
								dmCenteringLegend += (str.length(dmCenteringLegend) > 0 ? "\n" : "") + dmNumber + " · " + dmGlyph + " " + dmStartText
								dmExplanationLegend += (str.length(dmExplanationLegend) > 0 ? "\n" : "") + dmNumber + " · NON VINCOLATA" + (dmCanReassignLock ? "\n  Il vincolo puo' essere del ciclo prima" : "")
								dmHasDoubt := dmHasDoubt or dmCanReassignLock
			if showConstraintPanel and str.length(dmCenteringLegend) > 0
				int dmLegendRow = isIndex ? 7 : 8
				color dmLegendBg = color.new(color.rgb(25, 36, 49), 30)
				constraintRow(dmLegendRow, "ALTERNATIVE\n" + (isIndex ? "INDICE" : "INVERSO"), "CENTRATURA LIBERA\n" + dmCenteringLegend, "SPIEGAZIONE\n" + dmExplanationLegend, color.white, alternativeOpenColor, dmHasDoubt ? alternativeCloseColor : color.white, dmLegendBg)
			core.ConstraintScenario[] rtScenarios = isIndex ? indexScenarios : inverseScenarios
			core.CycleNode[] rtChain = state.chain
			line[] rtStore = state.timingLines
			// I linefill vengono eliminati automaticamente insieme a una delle linee
			// sorgente: un solo rtStore mantiene quindi rtTarget e fasce sempre sincronizzati.
			core.clearLineStore(rtStore)
			float rtY1 = low
			float rtY2 = high
			if rtY1 == rtY2
				float rtGap = math.max(math.abs(close) * 0.0001, syminfo.mintick)
				rtY1 -= rtGap
				rtY2 += rtGap
			if showConstraintTiming and array.size(rtChain) > 0
				core.CycleNode rtNode = array.last(rtChain)
				bool rtVisible = core.isActiveRegularNode(rtNode) and rtNode.isLocked and not rtNode.preLockInvalidated
				if rtVisible
					for rtTarget = 0 to 2
						int rtDuration = rtTarget == 0 ? cycleMinBars - 1 : rtTarget == 1 ? cycleMinBars : 44
						color rtMarkerColor = rtTarget == 0 ? timingEarlyColor : rtTarget == 1 ? timingMinColor : timing44Color
						int rtTargetBar = core.cycleCloseBarFromDuration(isIndex, rtNode.startBar, rtDuration)
						array.push(rtStore, core.indexVertical(rtTargetBar, rtY1, rtY2, color.new(rtMarkerColor, 78), extend.both, 5))
			if showPossibleConstraintRange and rangeOpacity > 0 and array.size(rtChain) > 0 and array.size(rtScenarios) > 0
				int rtChainSize = array.size(rtChain)
				core.CycleNode rtCurrent = array.last(rtChain)
				int rtOfficialLegacyStart = na
				bool rtOfficialLegacySpecial = rtChainSize > 1 and array.get(rtChain, rtChainSize - 2).raccType != RACC_NONE
				if rtChainSize > 1
					for rtI = rtChainSize - 2 to 0
						core.CycleNode rtOldNode = array.get(rtChain, rtI)
						if na(rtOfficialLegacyStart) and core.isVisibleDailyNode(rtOldNode) and rtOldNode.startBar < rtCurrent.startBar
							rtOfficialLegacyStart := rtOldNode.startBar
							break
				int rtCommonLeft = na
				int rtCommonCoreRight = na
				int rtLatestLegacy44 = na
				float rtRangeY1 = na
				bool rtForceDoubt = false
				for rtScenario in rtScenarios
					bool rtFree = na(rtScenario.lockBar) and not rtScenario.invalidated
					if rtFree
						int rtLeft = core.cycleCloseBarFromDuration(isIndex, rtScenario.startBar, 7)
						int rtCoreRight = core.cycleCloseBarFromDuration(isIndex, rtScenario.startBar, cycleMinBars - 2)
						rtCommonLeft := na(rtCommonLeft) ? rtLeft : math.max(rtCommonLeft, rtLeft)
						rtCommonCoreRight := na(rtCommonCoreRight) ? rtCoreRight : math.min(rtCommonCoreRight, rtCoreRight)
						float rtScenarioStartPrice = core.sidePivotOnBar(isIndex, rtScenario.startBar)
						if not na(rtScenarioStartPrice) and (na(rtRangeY1) or core.isMoreExtreme(isIndex, rtScenarioStartPrice, rtRangeY1))
							rtRangeY1 := rtScenarioStartPrice
						int rtLegacyStart = rtScenario.rank < 5000 ? rtScenario.lineageBar : rtOfficialLegacyStart
						if not na(rtLegacyStart) and rtLegacyStart < rtScenario.startBar
							int rtLegacy44 = core.cycleCloseBarFromDuration(isIndex, rtLegacyStart, rangeLegacyMaxBars)
							rtLatestLegacy44 := na(rtLatestLegacy44) ? rtLegacy44 : math.max(rtLatestLegacy44, rtLegacy44)
						if rtScenario.rank >= 5000 and rtOfficialLegacySpecial
							rtForceDoubt := true
				if not na(rtRangeY1) and not na(rtCommonLeft) and rtCommonLeft <= rtCommonCoreRight
					float rtRangeStep = math.max(math.abs(rtRangeY1) * 0.0001, syminfo.mintick)
					float rtRangeY2 = rtRangeY1 + (isIndex ? -rtRangeStep : rtRangeStep)
					int rtTransparency = 100 - rangeOpacity
					int rtDoubtRight = rtForceDoubt ? rtCommonCoreRight : na(rtLatestLegacy44) ? rtCommonLeft - 1 : math.min(rtCommonCoreRight, rtLatestLegacy44)
					int rtSafeLeft = rtForceDoubt ? rtCommonCoreRight + 1 : math.max(rtCommonLeft, na(rtLatestLegacy44) ? rtCommonLeft : rtLatestLegacy44 + 1)
					for rtBand = 0 to 2
						int rtLeft = rtBand == 0 ? rtCommonLeft : rtBand == 1 ? rtSafeLeft : rtCommonCoreRight + 1
						int rtRight = rtBand == 0 ? rtDoubtRight : rtBand == 1 ? rtCommonCoreRight : rtCommonCoreRight + 1
						color rtBandColor = rtBand == 1 ? (isIndex ? rangeSafeIndexColor : rangeSafeInverseColor) : rangeDoubtColor
						int rtVisibleLeft = math.max(bar_index, rtLeft)
						if rtVisibleLeft <= rtRight
							line rtLeftLine = core.indexVertical(rtVisibleLeft, rtRangeY1, rtRangeY2, color(na), extend.right, 1)
							line rtRightLine = core.indexVertical(rtRight + 1, rtRangeY1, rtRangeY2, color(na), extend.right, 1)
							array.push(rtStore, rtLeftLine)
							array.push(rtStore, rtRightLine)
							linefill.new(rtLeftLine, rtRightLine, color.new(rtBandColor, rtTransparency))
