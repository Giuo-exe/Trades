//@version=6
// ==============================================================================
// CICLI T-3: TREE & BACKTRACK V4
// ==============================================================================
// Motore ciclico speculare:
// - indice: cicli T-3 costruiti sui minimi;
// - inverso: cicli T-3i costruiti sui massimi.
//
// La compattazione deve restare lossless. Le funzioni comuni ricevono `isIndex`
// e sostituiscono esclusivamente blocchi speculari; soglie, priorita, vincoli,
// backtracking e ordine dei candidati non devono cambiare.
// ==============================================================================
indicator("Cicli T-3: Tree & Backtrack V4", "T-3 V4", overlay=true, scale=scale.none, max_lines_count=500, max_labels_count=500, max_bars_back=5000)
import peppogiuo/CicliCore/1 as core

// ==============================================================================
// 1. CONFIGURAZIONE CICLICA E STORAGE GRAFICO
// ==============================================================================
grp_tf = "01 · OPERATIVITÀ"
selectedTimeframe = input.timeframe("45", "Timeframe operativo", options=["15", "45"], group=grp_tf, inline="tf", tooltip="Il motore disegna soltanto quando il timeframe del grafico coincide con questo valore.")
assetType = input.string("Crypto-Commodity", "Mercato", options=["Crypto-Commodity", "Indici Standard", "Indici MIB"], group=grp_tf, inline="tf")
bool isStandardMarket = assetType == "Indici Standard"

// Indici Standard: 21-44 barre. Crypto/Commodity/MIB: 24-45 con eccezione 23.
cycleMinBars = isStandardMarket ? 21 : 24
cycleMaxBars = isStandardMarket ? 44 : 45
allow23Exception = not isStandardMarket
float constraintAtr = ta.atr(14)

// Finestre e anzianita minime dei raccordi intraday T-6, T-5 e T-4.
// R(T-3) e' invece il solo ponte fra settimanali e viene risolto a parte.
raccT4MinBars = isStandardMarket ? 12 : 11
raccT4MaxBars = isStandardMarket ? 20 : 21
raccT5MinBars = 6
raccT5MaxBars = 10
raccT6MinBars = 3
raccT6MaxBars = 5
raccT6MinAge = isStandardMarket ? 21 : 23
raccT5MinAge = isStandardMarket ? 44 : 48
raccT4MinAge = isStandardMarket ? 88 : 96
newTLeftBars = isStandardMarket ? 21 : 23
newTRightBars = isStandardMarket ? 44 : 48
weeklyMinCycles = 6
newTConfirmCycles = 11
newTColor = color.yellow
newTSoftColor = color.rgb(255, 245, 160)
specialResetColor = color.rgb(80, 170, 255)
emergencyRecoveryIndexColor = color.rgb(170, 88, 18)
emergencyRecoveryInverseColor = color.rgb(155, 89, 182)
alternativeCloseColor = #E74C3C
// Cache per barra: il resolver rivalida la struttura prima del lookup weekly.
// La chiave contiene lo start qualificato (na se invalido), non una copia della chain.
var map<string, int> evolvedRankCache = map.new<string, int>()
var table constraintTable = table.new(position.top_right, 3, 9, bgcolor=color.new(color.rgb(14, 20, 29), 12), frame_color=color.new(color.silver, 72), frame_width=1, border_color=color.new(color.silver, 86), border_width=1)
t3MinBars = 2
t2MinBars = 5
t1MinBars = isStandardMarket ? 11 : 10
rangeLegacyMaxBars = 44 // Solo blocker del range: non cambia il massimo del motore.
int RACC_NONE = 0
int RACC_T6 = 6
int RACC_T5 = 5
int RACC_T4 = 4
int RACC_T3 = 3
int RACC_INVALID = -1
int RACC_RESET = -3
int RACC_RECOVERY = -4
var float[] fibLevels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.272, 1.414, 1.618, 2.272, 2.414, 2.618)

grp_start = "01 · OPERATIVITÀ"
startTimeIndex = input.time(timestamp("2025-04-07 05:20:00"), "Indice (Low)", group=grp_start, inline="start", confirm=true)
startTimeInverse = input.time(timestamp("2025-04-07 07:20:00"), "Inverso (High)", group=grp_start, inline="start", confirm=true)
grp_core = "02 · MOTORE T-3"
currentCheckDelay = input.int(6, "Conferma DX", minval=5, maxval=10, group=grp_core, inline="engine", tooltip="Numero ordinario di barre della condizione destra. La recovery DX5 resta separata.")
maxBacktrackDepth = input.int(4, "Profondita backtracking", minval=1, maxval=10, group=grp_core, inline="engine", tooltip="Quanti livelli risalire durante il backtracking.")
fullBacktrackOnFailure = input.bool(true, "Backtracking completo su failure", group=grp_core, tooltip="Se una centratura produce vincoli o raccordi incoerenti, risale fino allo start disponibile.")
grp_style = "03 · CICLI E CANDIDATI"
cycleLabelLook = input.string("Pulito", "Label", options=["Pulito", "Classico"], group=grp_style, inline="look", tooltip="Pulito: testo ancorato a sinistra. Classico: box e orientamento originali.")
cleanCycleLabels = cycleLabelLook == "Pulito"
showDailyLines = input.bool(true, "Linee T-3", group=grp_style, inline="look")
showRaccordoLines = input.bool(true, "Linee raccordi", group=grp_style, inline="look")
cycleLineClearancePct = input.float(0.06, "Margine linea %", minval=0.0, maxval=0.5, step=0.01, group=grp_style, inline="offset", tooltip="Porta la linea oltre l'estremo senza cambiare i livelli logici.")
cycleLabelGapPct = input.float(0.04, "Distanza testo %", minval=0.0, maxval=0.5, step=0.01, group=grp_style, inline="offset")
grp_candidates = "03 · CICLI E CANDIDATI"
showGhosts = input.bool(true, "Candidati ghost", group=grp_candidates, inline="cand")
showConstraintAlternatives = input.bool(true, "Mostra centrature non vincolate", group=grp_candidates, tooltip="Con un vincolo principale attivo evidenzia con un pallino le sole centrature alternative ancora libere.")
visibleConstraintAlternatives = input.int(2, "Alternative visibili", minval=1, maxval=3, group=grp_candidates, tooltip="Limita i pallini sul grafico; tutte le centrature valide continuano a influenzare lo score.")
showBarCounter = input.bool(true, "Contatore barre", group=grp_candidates, inline="diag")
grp_constraint = "04 · VINCOLI"
weeklyConstraintEnabled = input.bool(true, "Vincolo settimanale", group=grp_constraint, tooltip="Colora i T-3 quando il settimanale risulta vincolato e ancora valido.")
weeklyIndexColor = input.color(color.rgb(210, 45, 45), "Linea settimanale indice", group=grp_constraint, inline="week")
weeklyInverseColor = input.color(color.rgb(0, 190, 140), "Linea settimanale inverso", group=grp_constraint, inline="week")
showConstraintPanel = input.bool(true, "Score centrature vincolate", group=grp_constraint, inline="score", tooltip="Mostra fino a tre centrature vincolate per lato. Lo score e' strutturale, non una probabilita' di profitto.")
showConstraintTiming = input.bool(true, "Mostra target minimo tempo vincolo", group=grp_constraint, inline="score")
showPossibleConstraintRange = input.bool(false, "Vedi range possibile vincolo", group=grp_constraint)
rangeSafeIndexColor = input.color(#2ECC71, "Range certo indice", group=grp_constraint, inline="range")
rangeSafeInverseColor = input.color(#00BFA5, "Range certo inverso", group=grp_constraint, inline="range")
rangeDoubtColor = input.color(#FFD54F, "Range dubbio", group=grp_constraint, inline="range-look")
rangeOpacity = input.int(18, "Opacità range %", minval=0, maxval=100, group=grp_constraint, inline="range-look", tooltip="0 nasconde il colore; 100 lo rende pieno.")
timingEarlyColor = input.color(#FFE0A3, "23 / 20", group=grp_constraint, inline="timing")
timingMinColor = input.color(#FFB74D, "24 / 21", group=grp_constraint, inline="timing")
timing44Color = input.color(#EF5350, "44", group=grp_constraint, inline="timing")
showLockFibonacci = input.bool(false, "Fibonacci T-3", group=grp_constraint, inline="fib")
showWeeklyLockFibonacci = input.bool(false, "Fibonacci settimanale", group=grp_constraint, inline="fib")
grp_colors = "05 · STILE E COLORI"
showEvolvedSwings = input.bool(false, "Debug view", group=grp_colors)
showHigherAnalysis = input.bool(false, "Analisi evoluta T+1 / T+2", group=grp_colors, tooltip="Origini superiori indipendenti: 13/24 giornalieri chiusi; vincolo mensile da 6 chiusi. Le linee usano Debug view e Debug 1–4.")
lineColorIndex = input.color(#FCCBCD, "Linea indice", group=grp_colors, inline="idx")
labelColorIndex = input.color(#FFF4F6, "Testo indice", group=grp_colors, inline="idx")
lineColorInverse = input.color(#C8E6C9, "Linea inverso", group=grp_colors, inline="inv")
labelColorInverse = input.color(#F1FFF4, "Testo inverso", group=grp_colors, inline="inv")
raccordoColor = input.color(#00BCD4, "Linea raccordo", group=grp_colors, inline="racc")
labelColorRaccordo = input.color(#B2EBF2, "Testo raccordo", group=grp_colors, inline="racc")
lineColorIndexLocked = input.color(color.rgb(220, 20, 60), "Linea indice vincolato", group=grp_colors, inline="idxv")
lockedTextColorIndex = input.color(#FFE4E8, "Testo indice vincolato", group=grp_colors, inline="idxv")
lineColorInverseLocked = input.color(color.rgb(0, 128, 0), "Linea inverso vincolato", group=grp_colors, inline="invv")
lockedTextColorInverse = input.color(#E8FFF0, "Testo inverso vincolato", group=grp_colors, inline="invv")
ghostColor = input.color(#95A5A6, "Candidati", group=grp_colors)
alternativeOpenColor = input.color(#2ECC71, "Alternative", group=grp_colors, inline="alt-mark")
alternativeMarkerShape = input.string("Cerchio", "Forma", options=["Cerchio", "Diamante", "Quadrato", "Triangolo"], group=grp_colors, inline="alt-mark")
swingT3Color = input.color(#FFFFFF00, "Debug 1", group=grp_colors, inline="swing")
swingTColor = input.color(#00E5FF00, "Debug 2", group=grp_colors, inline="swing")
swingT1Color = input.color(#B388FF00, "Debug 3", group=grp_colors, inline="swing")
swingT2Color = input.color(#FF6EC700, "Debug 4", group=grp_colors, inline="swing")
grp_prosp = "06 · PROSPETTICI"
prospT3Color = input.color(#9B59B6, "T-3", group=grp_prosp, inline="pcol")
prospT2Color = input.color(#F39C12, "T-2", group=grp_prosp, inline="pcol")
prospT1Color = input.color(#3498DB, "T-1", group=grp_prosp, inline="pcol")
prospMarkerShape = input.string("Croce", "Forma", options=["Cerchio", "Diamante", "Quadrato", "Triangolo", "Croce", "X"], group=grp_prosp, inline="pshape")
prospMarkerSize = input.string("Small", "Marker", options=["Tiny", "Small", "Normal", "Large"], group=grp_prosp, inline="pshape")
prospTextSize = input.string("Normal", "Testo", options=["Tiny", "Small", "Normal", "Large"], group=grp_prosp, inline="pshape")
prospShowShape = input.bool(true, "Forma", group=grp_prosp, inline="pvis")
prospShowText = input.bool(true, "Testo", group=grp_prosp, inline="pvis")
prospOffsetPct = input.float(0.12, "Offset %", minval=0.0, maxval=2.0, step=0.01, group=grp_prosp, inline="poff")
prospTextGapPct = input.float(0.08, "Gap testo %", minval=0.0, maxval=1.0, step=0.01, group=grp_prosp, inline="poff")
prospCurrentExtraPct = input.float(0.22, "Extra corrente %", minval=0.0, maxval=1.0, step=0.01, group=grp_prosp)
grp_advanced = "07 · AVANZATE"
debugMode = input.bool(false, "Debug", group=grp_advanced)

constraintRow(int row, string txt0, string txt1, string txt2, color fg0, color fg1, color fg2, color bg) =>
	for col = 0 to 2
		table.cell(constraintTable, col, row, col == 0 ? txt0 : col == 1 ? txt1 : txt2, text_color=col == 0 ? fg0 : col == 1 ? fg1 : fg2, bgcolor=bg, text_size=size.tiny)

// EP draft: gli input e il loop restano nell'indicatore; il motore e i tipi sono nella libreria.
var core.SideRuntime indexRuntime = core.newSideRuntime()
var core.SideRuntime inverseRuntime = core.newSideRuntime()
map<string, line> drawnSwingLines = na
map<string, label> drawnSwingLabels = na
map<string, int> drawnSwingKinds = na
core.EngineConfig cfg = core.EngineConfig.new(cycleMinBars, cycleMaxBars, allow23Exception, raccT4MinBars, raccT4MaxBars, raccT6MinAge, raccT5MinAge, raccT4MinAge, newTLeftBars, newTRightBars, t1MinBars, currentCheckDelay, maxBacktrackDepth, fullBacktrackOnFailure, cleanCycleLabels, showDailyLines, showRaccordoLines, cycleLineClearancePct, cycleLabelGapPct, showGhosts, weeklyConstraintEnabled, weeklyIndexColor, weeklyInverseColor, showEvolvedSwings, showHigherAnalysis, lineColorIndex, labelColorIndex, lineColorInverse, labelColorInverse, raccordoColor, labelColorRaccordo, lineColorIndexLocked, lockedTextColorIndex, lineColorInverseLocked, lockedTextColorInverse, ghostColor, swingT3Color, swingTColor, swingT1Color, swingT2Color, prospT3Color, prospT2Color, prospT1Color, prospMarkerShape, prospMarkerSize, prospTextSize, prospShowShape, prospShowText, prospOffsetPct, prospTextGapPct, prospCurrentExtraPct, debugMode)

// 15. MAIN BAR-BY-BAR
// ==============================================================================
// Il motore intraday e' attivo soltanto sul timeframe selezionato. Cambiare il
// grafico da 45m a 15m non deve lasciare visibili chain calcolate sull'altro TF.
float chartTfSeconds = timeframe.in_seconds()
float selectedTfSeconds = timeframe.in_seconds(selectedTimeframe)
bool renderEnabled = timeframe.isminutes and chartTfSeconds == selectedTfSeconds
drawnSwingLines := renderEnabled and barstate.islast ? map.new<string, line>() : na
drawnSwingLabels := renderEnabled and barstate.islast ? map.new<string, label>() : na
drawnSwingKinds := renderEnabled and barstate.islast ? map.new<string, int>() : na
core.EngineContext ctx = core.EngineContext.new(indexRuntime, inverseRuntime, evolvedRankCache, drawnSwingLines, drawnSwingLabels, drawnSwingKinds)

if not renderEnabled
	// Sul timeframe errato non restano ne' oggetti ne' stato del motore.
	for side = 0 to 1
		bool isIndex = side == 0
		core.SideRuntime resources = core.sideRuntime(ctx, isIndex)
		core.clearChain(resources.chain)
		core.clearChain(resources.weeklyHistory)
		core.clearLabelStore(resources.newTLabels)
		core.clearLabelStore(resources.ghostLabels)
		core.clearLabelStore(resources.scenarioLabels)
		core.clearLineStore(resources.swingLines)
		core.clearLineStore(resources.timingLines)
		core.clearFibObjects(resources.fibLockLines, resources.fibLockLabels)
		core.clearFibObjects(resources.fibWeeklyLines, resources.fibWeeklyLabels)
		label.delete(resources.counterLabel)
		array.clear(resources.triedStarts)
		resources.startBar := na
		resources.previousWeeklyStart := na
		resources.weeklyContextStart := na
		resources.weeklyWarning := false
		resources.lockCandidateBar := na
		resources.firstLockBar := na
		resources.weeklyLocked := false
		resources.preLockAlert := false
		resources.counterLabel := na
	if barstate.islast
		table.clear(constraintTable, 0, 0, 2, 8)
	map.clear(evolvedRankCache)
else
	for side = 0 to 1
		bool isIndex = side == 0
		core.SideRuntime sideState = core.sideRuntime(ctx, isIndex)
		int startTarget = isIndex ? startTimeIndex : startTimeInverse
		bool startReached = time >= startTarget and (barstate.isfirst or na(time[1]) or time[1] < startTarget)
		if na(sideState.startBar) and startReached
			sideState.startBar := bar_index
			sideState.weeklyContextStart := bar_index
			float price = core.sidePivot(isIndex)
			color baseColor = isIndex ? lineColorIndex : lineColorInverse
			core.CycleNode root = core.createNode(0, bar_index, price, price, bar_index, RACC_NONE)
			root.weeklyOrder := showHigherAnalysis ? 1 : 0
			color visibleLine = showDailyLines ? baseColor : color(na)
			root.lnCycle := core.cycleHorizontal(time, price, time, visibleLine)
			root.lnVert := core.cycleVertical(time, price, visibleLine)
			root.lblInfo := core.cycleTimeLabel(cfg, isIndex, time, price, isIndex ? "T" : "Ti", baseColor, core.dailyTextColor(cfg, isIndex, false), size.large)
			array.push(core.sideRuntime(ctx, isIndex).chain, root)
	// 0: rebase materializzati. 1: vincolo, origini virtuali, R(T-3).
	// 2: solo dopo processChain, recovery weekly dalla centratura persa.
	for weeklyPass = 0 to 2
		if weeklyPass == 1
			for side = 0 to 1
				bool isIndex = side == 0
				core.SideRuntime weeklyState = core.sideRuntime(ctx, isIndex)
				if array.size(weeklyState.chain) > 0
					core.CycleNode weeklyRoot = core.weeklyRootNode(ctx, isIndex, weeklyState.chain)
					core.weeklyConstraintStep(cfg, isIndex, weeklyState, bar_index, core.sidePivot(isIndex), weeklyRoot.startPrice)
		else if weeklyPass == 2
			for side = 0 to 1
				bool isIndex = side == 0
				core.processChain(cfg, ctx, isIndex, core.sideRuntime(ctx, isIndex))
		for side = 0 to 1
			bool isIndex = side == 0
			core.SideRuntime weeklyState = core.sideRuntime(ctx, isIndex)
			bool weeklyApplied = false
			int weeklyAttempts = weeklyPass == 1 ? 2 : 1
			for weeklyAttempt = 0 to weeklyAttempts - 1
				if not weeklyApplied
					int nextStart = na
					int parentBar = na
					int contextStart = weeklyState.startBar
					bool keepContext = false
					int policy = RACC_NONE
					if weeklyPass < 2 and weeklyAttempt == 0 and array.size(weeklyState.chain) > 0
						[selectedStart, selectedContext, selectedKeep, selectedParent] = core.selectWeeklyOrigin(cfg, ctx, isIndex, weeklyState.chain, weeklyPass == 0)
						nextStart := selectedStart
						parentBar := selectedParent
						contextStart := selectedContext
						keepContext := selectedKeep
					else if weeklyPass == 1 or weeklyPass == 2
						bool bridge = weeklyPass == 1
						parentBar := bridge and array.size(weeklyState.chain) > 0 ? array.last(weeklyState.chain).startBar : na
						nextStart := core.weeklyFallbackPoint(cfg, ctx, isIndex, weeklyState, bridge)
						policy := bridge ? RACC_T3 : RACC_RECOVERY
					if not na(nextStart) and nextStart != weeklyState.startBar
						weeklyApplied := core.commitWeeklyFallback(cfg, ctx, isIndex, weeklyState, nextStart, parentBar, contextStart, keepContext, policy)
	if array.size(indexRuntime.chain) > 0 and array.size(inverseRuntime.chain) > 0
		core.CycleNode currentIndex = array.last(indexRuntime.chain)
		core.CycleNode currentInverse = array.last(inverseRuntime.chain)
		if currentIndex.isLocked and currentInverse.isLocked and not currentIndex.isClosed and not currentInverse.isClosed
			int indexLockBar = core.firstLockBarUntil(cfg, true, currentIndex.startBar, currentIndex.startPrice, bar_index)
			int inverseLockBar = core.firstLockBarUntil(cfg, false, currentInverse.startBar, currentInverse.startPrice, bar_index)
			if not na(indexLockBar) and not na(inverseLockBar)
				if indexLockBar != inverseLockBar
					bool recenterIndex = indexLockBar < inverseLockBar
					core.SideRuntime recenterState = core.sideRuntime(ctx, recenterIndex)
					core.CycleNode[] recenterChain = recenterState.chain
					bool recenterApplied = false
					if array.size(recenterChain) > 0 and not na(recenterState.startBar)
						core.CycleNode recenterCurrent = array.last(recenterChain)
						bool recenterEligible = core.isActiveRegularNode(recenterCurrent) and recenterCurrent.isLocked
						bool viableCanonical = false
						bool parentContinuation = false
						if recenterEligible
							core.Candidate[] recenterCandidates = core.scanCandidates(cfg, recenterIndex, recenterCurrent.startBar)
							for c in recenterCandidates
								bool canonicalOk = c.sequenceValid and core.isConfirmedCanonicalCandidate(cfg, c)
								bool constraintOk = canonicalOk and c.constraintOk
								bool preLockOk = constraintOk and not core.wouldHavePreLockInvalidation(cfg, recenterIndex, recenterCurrent.startBar, recenterCurrent.startPrice, c.barIdx, core.diagnosticCandidateOk(cfg, c))
								if preLockOk
									viableCanonical := true
									break
							if array.size(recenterChain) >= 2
								core.CycleNode recenterParent = array.get(recenterChain, array.size(recenterChain) - 2)
								if recenterParent.raccType == RACC_NONE
									core.refreshCandidatesPreservingAttempts(cfg, recenterIndex, recenterParent)
									parentContinuation := not na(core.selectContinuationPick(cfg, ctx, recenterIndex, recenterParent, 3, false, recenterCurrent.startBar, na))
						if recenterEligible and not viableCanonical and not parentContinuation
							recenterApplied := core.resolveLocalLockedRaccordo(cfg, ctx, recenterIndex, recenterState, true)
						if recenterApplied
							core.CycleNode newCurrent = array.last(recenterChain)
							newCurrent.candidates := core.scanCandidates(cfg, recenterIndex, newCurrent.startBar)
							array.clear(recenterState.triedStarts)
	for side = 0 to 1
		bool isIndex = side == 0
		core.SideRuntime recenterState = core.sideRuntime(ctx, isIndex)
		core.CycleNode[] recenterChain = recenterState.chain
		int recenterSize = array.size(recenterChain)
		int raccordoPos = na
		int childPos = na
		int parentPos = na
		if recenterSize >= 4 and not na(recenterState.startBar)
			for pos = recenterSize - 1 to 0
				core.CycleNode node = array.get(recenterChain, pos)
				if na(raccordoPos) and pos < recenterSize - 1 and core.isRaccordo(node)
					raccordoPos := pos
				else if not na(raccordoPos) and na(parentPos) and not core.isRaccordo(node) and node.raccType != RACC_RESET and node.raccType != RACC_RECOVERY
					if na(childPos)
						childPos := pos
					else
						parentPos := pos
		if not na(parentPos) and not na(childPos)
			core.CycleNode parent = array.get(recenterChain, parentPos)
			core.CycleNode chosenChild = array.get(recenterChain, childPos)
			core.CycleNode raccordo = array.get(recenterChain, raccordoPos)
			parent.candidates := core.scanCandidates(cfg, isIndex, parent.startBar)
			int chosenScore = na
			core.Candidate best = na
			int bestScore = na
			for pass = 0 to 1
				if pass == 0 or not na(chosenScore)
					for c in parent.candidates
						bool evaluate = pass == 0 ? c.barIdx == chosenChild.startBar : c.barIdx != chosenChild.startBar and c.barIdx < raccordo.startBar and c.sequenceValid and core.isConfirmedCanonicalCandidate(cfg, c) and c.constraintOk
						if evaluate
							core.ContinuationPick candidatePick = core.candidateContinuationPick(cfg, ctx, isIndex, c)
							if pass == 0
								chosenScore := candidatePick.score
							else
								bool better = candidatePick.mode == 1 and candidatePick.score > chosenScore and (na(best) or candidatePick.score > bestScore or (candidatePick.score == bestScore and core.candidateTieBetter(cfg, ctx, isIndex, parent.startBar, c, best, true)))
								if better
									best := c
									bestScore := candidatePick.score
			if not na(best)
				core.trimChainTo(recenterChain, parentPos + 1)
				core.closeDailyAtCandidate(cfg, isIndex, parent, best, true)
				core.CycleNode replacement = core.buildDailyNode(cfg, parent.id + 1, best.barIdx, best.price, isIndex, true)
				array.push(recenterChain, replacement)
				replacement.candidates := core.scanCandidates(cfg, isIndex, replacement.startBar)
				array.clear(recenterState.triedStarts)
	for side = 0 to 1
		bool isIndex = side == 0
		core.SideRuntime capState = core.sideRuntime(ctx, isIndex)
		core.CycleNode[] capChain = capState.chain
		int visibleCount = 0
		int twelfthPos = na
		if array.size(capChain) > 0
			for i = 0 to array.size(capChain) - 1
				if core.isVisibleDailyNode(array.get(capChain, i))
					visibleCount += 1
					if visibleCount == 12
						twelfthPos := i
						core.CycleNode twelfth = array.get(capChain, i)
						if twelfth.raccType == RACC_NONE
							label.set_text(twelfth.lblInfo, "R(T-3)?")
		if visibleCount > 12 and not na(twelfthPos)
			core.trimChainTo(capChain, twelfthPos + 1)
			core.CycleNode capTail = array.get(capChain, twelfthPos)
			capTail.isClosed := false
			line.set_x2(capTail.lnCycle, time)
			capTail.candidates := core.scanCandidates(cfg, isIndex, capTail.startBar)
			array.clear(capState.triedStarts)
	core.CycleNode[] indexView = core.weeklyContextView(ctx, true, indexRuntime.chain)
